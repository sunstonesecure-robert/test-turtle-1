{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselines"],
  "properties": {
    "schemaVersion": {"const": 1},
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "targetOu", "required", "includeChildrenVerification"],
        "properties": {
          "name": {"const": "AWSControlTowerBaseline"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "targetOu": {"const": "Infrastructure"},
          "required": {"const": true},
          "includeChildrenVerification": {"const": true}
        }
      }
    }
  }
}
