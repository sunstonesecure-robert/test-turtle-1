{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["accessManagement", "backup", "centralizedLogging", "config", "governedRegions", "securityRoles"],
  "properties": {
    "accessManagement": {"$ref": "#/$defs/disabled"},
    "backup": {"$ref": "#/$defs/disabled"},
    "centralizedLogging": {"$ref": "#/$defs/loggingIntegration"},
    "config": {"$ref": "#/$defs/loggingIntegration"},
    "governedRegions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "securityRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "accountId"],
      "properties": {
        "enabled": {"const": true},
        "accountId": {"$ref": "#/$defs/accountIdOrPlaceholder"}
      }
    }
  },
  "not": {"required": ["organizationStructure"]},
  "$defs": {
    "disabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"const": false}}
    },
    "accountIdOrPlaceholder": {
      "type": "string",
      "anyOf": [
        {"pattern": "^[0-9]{12}$"},
        {"pattern": "^\\$\\{(LOG_ARCHIVE|AUDIT)_ACCOUNT_ID\\}$"}
      ]
    },
    "loggingIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "accountId", "configurations"],
      "properties": {
        "enabled": {"const": true},
        "accountId": {"$ref": "#/$defs/accountIdOrPlaceholder"},
        "configurations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accessLoggingBucket", "loggingBucket", "kmsKeyArn"],
          "properties": {
            "accessLoggingBucket": {"$ref": "#/$defs/retention"},
            "loggingBucket": {"$ref": "#/$defs/retention"},
            "kmsKeyArn": {
              "type": "string",
              "anyOf": [
                {"pattern": "^arn:aws-us-gov:kms:us-gov-[a-z]+-[0-9]:[0-9]{12}:key/.+$"},
                {"pattern": "^\\$\\{CONTROL_TOWER_KMS_KEY_ARN\\}$"}
              ]
            }
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retentionDays"],
      "properties": {"retentionDays": {"type": "integer", "minimum": 1}}
    }
  }
}
