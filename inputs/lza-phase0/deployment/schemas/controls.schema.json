{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "controls"],
  "properties": {
    "schemaVersion": {"const": 1},
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "enabled", "required", "targetOu", "parameters"],
        "properties": {
          "alias": {"type": "string", "minLength": 1},
          "enabled": {"const": true},
          "required": {"const": true},
          "targetOu": {"const": "Infrastructure"},
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": ["AllowedRegions", "ExemptedPrincipalArns", "ExemptedActions"],
            "properties": {
              "AllowedRegions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "ExemptedPrincipalArns": {"type": "array", "items": {"type": "string"}},
              "ExemptedActions": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
